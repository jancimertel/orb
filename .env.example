# Telegram bot auth
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_ID=

# Claude auth
ANTHROPIC_API_KEY=

# Optional read-only Anthropic API key used ONLY to list models for /model.
# Kept out of the CLI subprocess, so model runs still bill to your subscription.
# Leave unset to use the built-in curated model list.
MODELS_API_KEY=

# GitHub PAT (simple token)
GITHUB_PAT=

# Git config
GIT_USER_NAME=
GIT_USER_EMAIL=

# Optional (defaults shown)
DEFAULT_MODEL=claude-sonnet-4-8
LOG_LEVEL=info
LOG_FORMAT=json
APPROVAL_TIMEOUT_SEC=60
MAX_SESSIONS_LISTED=10
DB_PATH=/data/state/state.db
