# Telegram bot auth
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_ID=

# Claude auth
ANTHROPIC_API_KEY=

# Optional read-only Anthropic API key used ONLY to list models for /model.
# Kept out of the CLI subprocess, so model runs still bill to your subscription.
# Leave unset to use the built-in curated model list.
MODELS_API_KEY=

# GitHub PAT (simple token)
GITHUB_PAT=

# Git config
GIT_USER_NAME=
GIT_USER_EMAIL=

# Optional (defaults shown)
DEFAULT_MODEL=claude-sonnet-4-8
LOG_LEVEL=info
LOG_FORMAT=json
APPROVAL_TIMEOUT_SEC=60
MAX_SESSIONS_LISTED=10
DB_PATH=/data/state/state.db

# Claude Code plugins to install + enable at startup (comma-separated
# <plugin>@<marketplace> keys). AUTHORITATIVE: removing a key and restarting
# disables that plugin (only the listed plugins load). Default shown below.
PLUGINS=gopls-lsp@claude-plugins-official,frontend-design@claude-plugins-official,superpowers@claude-plugins-official,code-review@claude-plugins-official,andrej-karpathy-skills@karpathy-skills,google-go-style@cicdteam
# Marketplaces to register (comma-separated). Add more sources to install
# plugins from other marketplaces, then reference them via @<marketplace> above.
PLUGIN_MARKETPLACE_SOURCES=anthropics/claude-plugins-official,multica-ai/andrej-karpathy-skills,cicdteam/google-go-style
